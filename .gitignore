# =========================================================================
# Unity 6+ - GitIgnore Definitivo (Android, Windows, Web, IDEs)
# =========================================================================

# --- Pastas temporárias e de cache do Unity ---
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# --- Cache do Android / Gradle / CMake (Unity 6+) ---
.gradle/
.utmp/

# --- Pastas de Builds (Windows, Android, Web, etc.) ---
/[Bb]uild/
/[Bb]uilds/
/ExportedObj/

# --- Extensões de executáveis e pacotes gerados ---
*.apk
*.aab
*.exe
*.app
*.unitypackage
*.apk.meta
*.aab.meta
*.exe.meta
*.unitypackage.meta

# --- Arquivos gerados por IDEs (Visual Studio, Rider, VS Code) ---
.vs/
.idea/
.vscode/
/*.sln
/*.slnx
/*.csproj
/*.unityproj
/*.suo
/*.tmp
/*.user
/*.userprefs
/*.pidb
/*.booproj
/*.svd
/*.pdb
/*.mdb
/*.opendb
/*.VC.db

# --- Metas gerados por arquivos temporários de IDE ---
*.pidb.meta
*.pdb.meta
*.mdb.meta

# --- Plugins de terceiros e ferramentas autogeradas ---
/[Aa]ssets/Plugins/Editor/JetBrains*
*.DotSettings.user

# --- Relatórios de erro e Crash ---
sysinfo.txt
mono_crash.*
crashlytics-build.properties

# --- Sistemas de interface (UI Toolkit / Visual Scripting) ---
/UIElementsSchema/
/[Aa]ssets/Unity.VisualScripting.Generated/

# --- Addressables (Evita commitar dados pesados de assets locais) ---
/ServerData/
/[Aa]ssets/StreamingAssets/aa*
/[Aa]ssets/AddressableAssetsData/link.xml*
/[Aa]ssets/Addressables_Temp*
/[Aa]ssets/AddressableAssetsData/*/*.bin*

# --- Arquivos do Sistema Operacional ---
.DS_Store
Thumbs.db
